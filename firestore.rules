rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'barkissac80@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // 2. Private admin catalogue: never readable by public visitors.
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // 3. Sanitized public product copies contain no paid download URL.
    match /products_public/{productId} {
      allow read: if resource.data.get('is_active', true) == true || isAdmin();
      allow write: if isAdmin();
    }

    // Paid audio download URLs are isolated from every public document.
    match /product_private/{productId} {
      allow read, write: if isAdmin();
    }

    // Migration state is admin-only.
    match /system_migrations/{migrationId} {
      allow read, write: if isAdmin();
    }

    // 4. Categories collection
    match /categories/{categoryId} {
      allow read: if (resource == null || resource.data.get('is_active', true) == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Lead Magnets collection
    match /lead_magnets/{leadMagnetId} {
      allow read: if (resource == null || resource.data.get('active', true) == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 6. Leads collection (Confidentiality: Public can create, only admin can read/manage)
    match /leads/{leadId} {
      allow create: if (request.resource.data.first_name is string &&
                       request.resource.data.first_name.size() > 0 &&
                       request.resource.data.first_name.size() <= 128 &&
                       request.resource.data.whatsapp is string &&
                       request.resource.data.whatsapp.size() >= 8 &&
                       request.resource.data.whatsapp.size() <= 64) || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // 7. Testimonials collection
    match /testimonials/{testimonialId} {
      allow read: if (resource == null || resource.data.get('is_active', true) == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 8. Blog Posts collection
    match /blog_posts/{postId} {
      allow read: if (resource == null || resource.data.get('is_published', true) == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 9. Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Analytics collection
    match /analytics/{eventId} {
      allow create: if request.resource.data.event_type is string &&
                       request.resource.data.page is string;
      allow read, update, delete: if isAdmin();
    }

    // 11. VIP Packs collection
    match /vip_packs/{vipPackId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
